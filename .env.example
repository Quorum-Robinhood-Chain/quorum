# ── Database (Supabase or Neon — paste your connection strings) ───────────
# Supabase: Project Settings → Database → Connection string (URI, "Transaction" mode) for DATABASE_URL,
#           and the "Session" mode string for DIRECT_URL (needed for migrations through the pooler).
# Neon:     the branch's pooled connection string for DATABASE_URL, and the unpooled one for DIRECT_URL.
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.olvugxjkrenfxicrohcz:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.olvugxjkrenfxicrohcz:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"

# ── Redis (BullMQ) ──────────────────────────────────────────────────────────
# Any managed Redis works (Upstash, Redis Cloud, local docker). Upstash needs rediss:// (TLS).
REDIS_URL="rediss://default:gQAAAAAABEb5AAIgcDE5ODI4N2RmZDZmOGQ0OTZlOWVkMjdjZTYwYTY1YTk0MA@relative-slug-280313.upstash.io:6379"

# ── Mimo / Xiaomi (LLM generation pipeline, §8.4) ───────────────────────────
# OpenAI-compatible chat-completions API. Docs: https://mimo.mi.com/docs/en-US/api/chat/openai-api
MIMO_API_KEY=""
MIMO_BASE_URL="https://api.xiaomimimo.com/v1"
MIMO_MODEL="mimo-v2.5-pro"

# ── Admin auth (existing feature — unchanged) ───────────────────────────────
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"
ADMIN_SESSION_SECRET="change-me-too"

# Shared secret required in the `x-cron-secret` header to call /api/admin/trigger
# (manual/out-of-cycle job trigger, §6.3 "on-demand" posts). Generate a random string.
CRON_TRIGGER_SECRET="change-me-as-well"

# ── News sources (§7.1) ─────────────────────────────────────────────────────
# IMPORTANT — unresolved open question from the brief (§17): confirm these two things
# before turning ingestion on:
#   1. Does an official RSS/API feed exist? (BEINCRYPTO_FEED_URL / COINFOMANIA_FEED_URL below
#      are best-guess WordPress-style feed paths, NOT verified — check manually.)
#   2. What do robots.txt and ToS say about automated access? (see lib/services/sources/*.ts)
# If no feed exists and scraping is the only option, keep the poll interval at 15–30 min,
# fetch headline+excerpt+link only, and set a descriptive User-Agent (already done in code).
BEINCRYPTO_FEED_URL="https://beincrypto.com/feed/"
COINFOMANIA_FEED_URL="https://coinfomania.com/feed/"
INGEST_USER_AGENT="QuorumBot/1.0 (+https://quorum.example/about; contact: editorial@quorum.example)"

# ── Market & on-chain data (§7.2) ───────────────────────────────────────────
# DefiLlama has no auth / no key required. Confirm the exact chain slug DefiLlama uses
# for Robinhood Chain once it's listed (placeholder below).
DEFILLAMA_CHAIN_SLUG="robinhood-chain"

# CoinGecko: free tier works without a key at low volume; add a Pro key to raise rate limits.
COINGECKO_API_KEY=""

# Morpho's public GraphQL API (blue-api.morpho.org) needs no key. Set the USDG market id
# once confirmed on Robinhood Chain.
MORPHO_USDG_MARKET_ID=""

# Robinhood Chain RPC (chain ID 4663) + factory/oracle addresses — fill in once confirmed.
RHC_CHAIN_ID="4663"
RHC_RPC_URL=""
RHC_BLOCK_EXPLORER_API_URL=""
RHC_BLOCK_EXPLORER_API_KEY=""

# Chainlink price feed aggregator addresses on Robinhood Chain, JSON map of symbol -> address.
# Example: {"AAPLx":"0x...","NVDAx":"0x..."}
CHAINLINK_FEED_MAP="{}"

# Robinhood-only token data: read price + 24h volume straight off Robinhood Chain via RPC
# (no third-party subgraph needed). JSON map of symbol -> pool config. Get the pool address
# from RHC_BLOCK_EXPLORER_API_URL by looking up the token's contract, finding its liquidity
# pool/pair. See lib/services/market/onchainPools.ts for the full config shape.
# Example: {"ARC":{"pool":"0x...","tokenIsToken0":true,"tokenDecimals":18,"quoteDecimals":6,"quoteUsdPrice":1}}
TOKEN_POOL_MAP="{}"
# Blocks/day for the 24h volume window — override once real Robinhood Chain block time is known.
RHC_BLOCKS_PER_DAY="43200"

# Third-party DEX subgraph / API endpoints — Arcus, Uniswap, 1inch, Lighter (§7.2).
# Disabled by default (set ENABLE_DEX_SUBGRAPHS="true" to turn back on). Only useful once
# each DEX confirms & indexes an actual Robinhood Chain deployment — until then prefer
# TOKEN_POOL_MAP above (see lib/services/market/dexSubgraph.ts).
ENABLE_DEX_SUBGRAPHS="false"
UNISWAP_SUBGRAPH_URL=""
ARCUS_SUBGRAPH_URL=""
ONEINCH_API_URL=""
LIGHTER_API_URL=""
