# Copy to .env for local dev, and add the same keys in Vercel → Settings → Environment Variables.
# Save this file with LF line endings: a trailing CR from a Windows editor used to get glued
# onto secrets and break the Authorization header (lib/env.ts now strips it either way).

# ── Database (Postgres: Supabase, Neon, RDS…) ───────────────────────────────
# Supabase: Settings → Database → "Transaction" pooler URI for DATABASE_URL,
#           "Session" pooler URI for DIRECT_URL (migrations can't run through pgbouncer).
# Neon:     pooled connection string for DATABASE_URL, unpooled for DIRECT_URL.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# ── MiMo / Xiaomi (LLM generation pipeline, §8.4) ───────────────────────────
# OpenAI-compatible chat completions. Docs: https://mimo.mi.com/docs/en-US/api/chat/openai-api
# The key is sent as `Authorization: Bearer <key>`.
# Standard plan keys use the default base URL below. A Token Plan key (tp-…) requires the
# dedicated regional host from the MiMo console, e.g. https://token-plan-sgp.xiaomimimo.com/v1
MIMO_API_KEY=""
MIMO_BASE_URL="https://api.xiaomimimo.com/v1"
MIMO_MODEL="mimo-v2.5-pro"

# ── Admin auth ──────────────────────────────────────────────────────────────
# ADMIN_SESSION_SECRET is REQUIRED in production and must be set before the build:
# the Edge middleware and the Node route handlers both sign with it, and a missing
# value used to leave them on different defaults, so no session ever verified.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"
ADMIN_SESSION_SECRET="generate-with: openssl rand -hex 32"

# ── Scheduled jobs ──────────────────────────────────────────────────────────
# CRON_SECRET is what Vercel Cron sends as `Authorization: Bearer …` (set it in Vercel).
# CRON_TRIGGER_SECRET lets an external scheduler or curl call the same routes via `x-cron-secret`.
CRON_SECRET=""
CRON_TRIGGER_SECRET=""

# ── News sources (§7.1) ─────────────────────────────────────────────────────
# Open question from the brief (§17): confirm an official feed exists and check robots.txt +
# ToS before enabling. The paths below are best-guess WordPress feeds, NOT verified.
# Leave a feed URL blank and that source is skipped rather than scraped.
BEINCRYPTO_FEED_URL="https://beincrypto.com/feed/"
COINFOMANIA_FEED_URL="https://coinfomania.com/feed/"
INGEST_USER_AGENT="QuorumBot/1.0 (+https://quorum.example/about; contact: editorial@quorum.example)"

# ── Market & on-chain data (§7.2) ───────────────────────────────────────────
# DefiLlama needs no key. Confirm the real chain slug once Robinhood Chain is listed.
DEFILLAMA_CHAIN_SLUG="robinhood-chain"

# CoinGecko free tier works without a key; add a Pro key for higher rate limits.
COINGECKO_API_KEY=""

# Morpho's public GraphQL API needs no key. Set the USDG market id once confirmed.
MORPHO_USDG_MARKET_ID=""

# Robinhood Chain RPC (chain ID 4663). Without this, on-chain reads are skipped, not failed.
RHC_CHAIN_ID="4663"
RHC_RPC_URL=""
RHC_BLOCKS_PER_DAY="43200"

# Stock Token ERC-20 contracts, JSON map of underlying ticker -> address.
# These are plain ERC-20s, not Chainlink aggregators — the USD quote comes from the
# underlying equity price; the contract is only used to verify the address is live.
STOCK_TOKEN_MAP="{}"

# DEX-listed tokens read straight off-chain, JSON map of symbol -> Uniswap-V2-style pool config.
# Example: {"ARC":{"pool":"0x…","tokenIsToken0":true,"tokenDecimals":18,"quoteDecimals":6,"quoteUsdPrice":1}}
TOKEN_POOL_MAP="{}"

# DEX factory contracts for new-pair detection, JSON map of dex name -> factory address.
DEX_FACTORY_MAP="{}"
