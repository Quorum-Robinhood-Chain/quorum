# Copy to .env for local dev, and set the same keys in Vercel → Settings → Environment Variables.

# ── Database (Postgres) ──────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# ── MiMo / Xiaomi (LLM generation) ───────────────────────────────────
MIMO_API_KEY=""
MIMO_BASE_URL="https://api.xiaomimimo.com/v1"
MIMO_MODEL="mimo-v2.5-pro"

# ── Admin auth ────────────────────────────────────────────────────────
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"
ADMIN_SESSION_SECRET="generate-with: openssl rand -hex 32"

# ── Scheduled jobs ──────────────────────────────────────────────────────────
CRON_SECRET=""
CRON_TRIGGER_SECRET=""

# ── News sources  ─────────────────────────────────────────────────────
BEINCRYPTO_FEED_URL="https://beincrypto.com/feed/"
COINFOMANIA_FEED_URL="https://coinfomania.com/feed/"
INGEST_USER_AGENT="QuorumBot/1.0 (+https://quorum.example/about; contact: editorial@quorum.example)"

# X/Twitter, scraped via Apify (no X API tier needed)
APIFY_API_TOKEN="add your Apify API token here"
APIFY_ACTOR_ID="apidojo/tweet-scraper"
APIFY_MONITORED_ACCOUNTS=""
APIFY_MAX_RESULTS_PER_CYCLE="25"

# ── Market & on-chain data (§7.2) ───────────────────────────────────────────
DEFILLAMA_CHAIN_SLUG="robinhood-chain"
COINGECKO_API_KEY=""
MORPHO_USDG_MARKET_ID=""
RHC_CHAIN_ID="4663"
RHC_RPC_URL=""
RHC_BLOCKS_PER_DAY="43200"
# STOCK_TOKEN_MAP removed — Stock Token contract addresses now come from Robinhood's
# own /rhj/assets catalog via `stock-tokens-sync` (lib/market/sync-stock-tokens.ts),
# not a hand-maintained env var. See prisma/seed.ts for how to populate them locally.
TOKEN_POOL_MAP="{}"
DEX_FACTORY_MAP="{}"

# ── Trending tokens — auto-discovered on Robinhood Chain via Blockscout ─────
# Free key at https://dev.blockscout.com. Leave BLOCKSCOUT_API_KEY empty to
# disable this feature (trending-tokens-sync will just no-op). See
# lib/market/blockscout.ts and lib/market/sync-trending-tokens.ts.
BLOCKSCOUT_API_KEY=""
BLOCKSCOUT_CHAIN_ID="4663"
BLOCKSCOUT_MIN_HOLDERS="25"

# ── $QUORUM access-gating token ─────────────────────────────────────────────
QUORUM_TOKEN_RPC_URL=""
QUORUM_TOKEN_ADDRESS=""
QUORUM_TOKEN_DECIMALS="18"
QUORUM_MIN_BALANCE="50000"
GATE_WINDOW_MINUTES="60"
